{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/pricing",
      "destination": "/seo/pricing.html"
    },
    {
      "source": "/Pricing",
      "destination": "/seo/pricing.html"
    },
    {
      "source": "/faq",
      "destination": "/seo/faq.html"
    },
    {
      "source": "/Faq",
      "destination": "/seo/faq.html"
    },
    {
      "source": "/legal-diary",
      "destination": "/seo/legal-diary.html"
    },
    {
      "source": "/developers",
      "destination": "/seo/developers.html"
    },
    {
      "source": "/Developers",
      "destination": "/seo/developers.html"
    },
    {
      "source": "/terms",
      "destination": "/seo/terms.html"
    },
    {
      "source": "/Terms",
      "destination": "/seo/terms.html"
    },
    {
      "source": "/privacy",
      "destination": "/seo/privacy.html"
    },
    {
      "source": "/Privacy",
      "destination": "/seo/privacy.html"
    },
    {
      "source": "/security",
      "destination": "/seo/security.html"
    },
    {
      "source": "/Security",
      "destination": "/seo/security.html"
    },
    {
      "source": "/disclaimer",
      "destination": "/seo/disclaimer.html"
    },
    {
      "source": "/Disclaimer",
      "destination": "/seo/disclaimer.html"
    },
    {
      "source": "/help",
      "destination": "/seo/help.html"
    },
    {
      "source": "/Help",
      "destination": "/seo/help.html"
    },
    {
      "source": "/help/:slug",
      "destination": "/seo/help/:slug.html"
    },
    {
      "source": "/((?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
